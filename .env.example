# Servidor estático local (scripts/serve.js)
PORT=3000
HOST=127.0.0.1

# Ficam só no servidor (Vercel → Environment Variables, ou neste .env local).
# Não coloque estes valores em reload/js.
RAWG_KEY=
MYMEMORY_EMAIL=

# Supabase — configure também em reload/js/config.js (ou config.local.js)
# Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Auth Dashboard (recomendado em lab local):
# Authentication → Providers → Email enabled
# Authentication → Providers → Email → Confirm email = OFF
# Authentication → URL Configuration → Site URL = http://localhost:3000
# Redirect URLs += http://localhost:3000/reload/index.html
